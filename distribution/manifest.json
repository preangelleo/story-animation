  "install": {
    "post_install": [
      "阅读 documentation/PROVIDERS.md，按自己的环境配置依赖、字体和供应商；不默认开始付费制作。",
      "安装后执行 python3 tools/configure_roles.py --execute 配置本工作区thumbnail-designer的gpt-6.1-sol；缺Codex内置image_gen不得用收费API冒充。"
    ],
    "verify": "python3 bin/story-animation doctor"
  },
  "name": "story-animation",
  "permissions": {
    "exec": true,
    "network": true,
    "secrets": [
      "ELEVENLABS_API_KEY",
      "ELEVENLABS_VOICE_ID",
      "ARK_AGENT_PLAN_API_KEY",
      "REPLICATE_API_TOKEN"
    ],
    "tools": [
      "Read",
      "Write",
      "Edit",
      "Bash"
    ]
  },
  "requires": {
    "cli": [
      {
        "name": "python3",
        "optional": false
      },
      {
        "name": "ffmpeg",
        "optional": true
      },
      {
        "name": "ffprobe",
        "optional": true
      },
      {
        "name": "opencode",
        "optional": true
      },
      {
        "name": "node",
        "optional": true
      },
      {
        "name": "npx",
        "optional": true
      }
    ],
    "env": [
      {
        "description_zh": "使用者自己的供应商凭据，不随包分发",
        "name": "ELEVENLABS_API_KEY",
        "required": false,
        "secret": true
      },
      {
        "description_zh": "使用者自己的供应商凭据，不随包分发",
        "name": "ELEVENLABS_VOICE_ID",
        "required": false,
        "secret": true
      },
      {
        "description_zh": "使用者自己的供应商凭据，不随包分发",
        "name": "ARK_AGENT_PLAN_API_KEY",
        "required": false,
        "secret": true
      },
      {
        "description_zh": "使用者自己的供应商凭据，不随包分发",
        "name": "REPLICATE_API_TOKEN",
        "required": false,
        "secret": true
      }
    ],
    "harness": [
      "claude_code",
      "codex",
      "opencode"
    ],
    "os": [
      "linux",
      "macos"
    ],
    "python_requirements": "scaffold/requirements.txt"
  },
  "roles": [
    {
      "description": "先真实检索并归档 dossier/sources，区分事实/流传说法/演绎/版权，不写故事正文。",
      "name": "story-researcher"
    },
    {
      "description": "由已收集素材提炼1—3核心思想和一句takeaway；精确人物引用核来源，否则署名本片总结。",
      "name": "theme-planner"
    },
    {
      "description": "Installer-configured Codex/Claude/Ark/custom author; frozen materials and compact angle advice only, no research/tools or full history.",
      "name": "story-author"
    },
    {
      "description": "独立审大纲与完整稿、逻辑/动机/线索/史实与来源、语义字幕；作者不得自签PASS。",
      "name": "story-editor"
    },
    {
      "description": "先定妆，逐镜带真实参考图；独立视角构图，静图静止、完整画面无底带，无意重复拒绝。",
      "name": "character-designer"
    },
    {
      "description": "预算/unknown门；配音→ASR全文差异→原稿FA→语义字幕→最多三视频→静图clip→混音→烧录→时钟QA。",
      "name": "media-producer"
    },
    {
      "description": "按语义分章；使用可改参数A/C1双艺术字和弱音量声音，先交使用者定稿；独立clip只插完整scene边界，typed EDL加全帧核验。",
      "name": "chapter-transition-designer"
    },
    {
      "description": "table是真相，vector只召回候选；发布后72h/7d/28d分析真实指标，缺值明确，不虚构观众反馈。",
      "name": "audience-analyst"
    },
    {
      "description": "默认演练，先核独立OAuth/profile与channel ID；使用者明确发布授权后CEO上传回读，不启动timer。",
      "name": "release-operator"
    },
    {
      "description": "维护本包拥有的schema/CLI/回归，不读写任何人的共享凭据或重建本机共享工具。",
      "name": "dev-maintainer"
    },
    {
      "description": "Codex gpt-6.1-sol + built-in image_gen; per-episode parameterized thumbnails; actual small-preview review",
      "name": "thumbnail-designer"
    },
    {
      "name": "thumbnail-preproducer",
      "description": "Final-canvas thumbnail contract, dedicated Codex designer handoff, prepare/verify/consume gate before final composition."
    },
    {
      "name": "dedup-adviser",
      "description": "Independent compact SQL/vector duplicate and angle advice; frozen plan first."
    },
    {
      "name": "feedback-analyst",
      "description": "Independent opt-in public comment assessment; exact approved replies and provenance-preserving topic suggestions."
    }
  ],
  "schema_version": "agentj.catalog/v1",
  "summary_en": "Research-first storytelling, configurable authors, covers and chapters, with optional SQL/vector memory, independent dedup and audience feedback.",
  "summary_zh": "研究优先的动画故事工作流：可配作者、封面与章节；SQL/vector记忆、独立查重、评论回复与选题模块均可选。",
  "tags": [
    "story",
    "animation",
    "chinese",
    "video"
  ],
  "title_en": "Story Animation",
  "title_zh": "Story Animation 动画故事工作流",
  "type": "workflow",
  "version": "1.2.1"
}
