{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qy-style-catalog-v1",
  "description": "Structural contract. storyflow.style_registry.validate_catalog additionally checks uniqueness and style-only safety.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "styles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "id",
          "name",
          "description",
          "prompt",
          "palette",
          "lighting",
          "source"
        ],
        "properties": {
          "index": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "palette": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "lighting": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "version",
              "url"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
