{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qy-weekly-series-v1",
  "description": "Executable validator additionally checks all weekdays/keys uniqueness and catalog references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timezone",
    "series"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timezone": {
      "const": "Asia/Tokyo"
    },
    "series": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "display_name",
          "weekday",
          "default_style_index",
          "description"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "weekday": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "default_style_index": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    }
  }
}
